# Copy to .env (gitignored). Without ZETARIS_BASE_URL the agent runs on the offline synthetic fixture.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
# Preferred: an API token from Management -> API Tokens (or `npm run zetaris:token`).
ZETARIS_API_KEY=
# Alternative: username/password login (token refreshed automatically).
# ZETARIS_USERNAME=admin@zetaris.com
# ZETARIS_PASSWORD=
# Optional
# ZETARIS_ENGINE_ID=
# ZETARIS_TIMEOUT_MS=300000
# AGENT_ADAPTER=fixture   # force the offline fixture
# PORT=8787
# MEMORY_DIR=.memory/zetaris
